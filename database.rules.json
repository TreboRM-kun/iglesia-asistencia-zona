        ".write": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')"
      }
    },
    "FacilitadoresPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'"
      }
    },
    "DiscipuladoVirtualPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')"
      }
    },
    "Anuncios": {
