        ".write": false
      }
    },
    "AportesLimpieza": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor' || (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && query.orderByChild == 'uid' && query.equalTo == auth.uid))",
      ".indexOn": ["uid"],
      "$id": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && ((!data.exists() && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && newData.child('uid').val() == auth.uid && newData.child('zona').val() == root.child('Perfiles').child(auth.uid).child('salon').val() && (newData.child('zona').val() == 'Zona 1' || newData.child('zona').val() == 'Zona 2' || newData.child('zona').val() == 'Zona 3' || newData.child('zona').val() == 'Zona 4' || newData.child('zona').val() == 'Zona 5' || newData.child('zona').val() == 'Zona 6') && !newData.child('comentarioRevision').exists() && !newData.child('revisadoPor').exists() && !newData.child('uidRevisor').exists() && !newData.child('fechaRevision').exists()) || (data.exists() && newData.exists() && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')))",
        ".validate": "(!data.exists() && newData.hasChildren(['uid', 'usuario', 'zona', 'monto', 'semana', 'comentario', 'fechaRegistro', 'estado', 'rutaComprobante']) && newData.child('uid').val() == auth.uid && newData.child('usuario').isString() && newData.child('usuario').val() == root.child('Perfiles').child(auth.uid).child('usuario').val() && newData.child('zona').val() == root.child('Perfiles').child(auth.uid).child('salon').val() && newData.child('monto').isNumber() && newData.child('monto').val() > 0 && newData.child('monto').val() <= 1000000000 && newData.child('semana').isString() && newData.child('semana').val().length == 10 && newData.child('comentario').isString() && newData.child('comentario').val().length <= 500 && newData.child('fechaRegistro').isNumber() && newData.child('estado').val() == 'Pendiente' && newData.child('rutaComprobante').isString() && (newData.child('rutaComprobante').val() == '' || newData.child('rutaComprobante').val() == 'comprobantes-limpieza/' + auth.uid + '/' + $id)) || (data.exists() && newData.child('uid').val() == data.child('uid').val() && newData.child('usuario').val() == data.child('usuario').val() && newData.child('zona').val() == data.child('zona').val() && newData.child('monto').val() == data.child('monto').val() && newData.child('semana').val() == data.child('semana').val() && newData.child('comentario').val() == data.child('comentario').val() && newData.child('fechaRegistro').val() == data.child('fechaRegistro').val() && newData.child('rutaComprobante').val() == data.child('rutaComprobante').val() && (newData.child('estado').val() == 'Confirmado' || newData.child('estado').val() == 'Requiere aclaración') && newData.child('comentarioRevision').isString() && newData.child('comentarioRevision').val().length <= 500 && newData.child('revisadoPor').val() == root.child('Perfiles').child(auth.uid).child('usuario').val() && newData.child('uidRevisor').val() == auth.uid && newData.child('fechaRevision').isNumber())",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "usuario": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "zona": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "monto": {
          ".validate": "newData.isNumber()"
        },
        "semana": {
          ".validate": "newData.isString() && newData.val().length == 10"
        },
        "comentario": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "fechaRegistro": {
          ".validate": "newData.isNumber()"
        },
        "estado": {
          ".validate": "newData.isString()"
        },
        "rutaComprobante": {
          ".validate": "newData.isString() && newData.val().length <= 220"
        },
        "comentarioRevision": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "revisadoPor": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "uidRevisor": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "fechaRevision": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
