{
  "rules": {
    ".read": false,
    ".write": false,
    "LideresPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador')"
      }
    },
    "AsistenciasPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')"
      }
    },
    "FacilitadoresPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'"
      }
    },
    "DiscipuladoVirtualPorZona": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      "$zona": {
        ".read": "auth != null && ((root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && $zona != 'Virtual' && $zona != 'Pastor' && root.child('Perfiles').child(auth.uid).child('salon').val() == $zona) || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')"
      }
    },
    "Anuncios": {
      ".read": true,
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'"
    },
    "LideresPastorIglesiaRedencionV2": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'"
    },
    "Perfiles": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": false
      }
    },
    "AportesLimpieza": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      "$id": {
        ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        ".write": "!data.exists() && auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && newData.child('uid').val() == auth.uid && newData.child('zona').val() == root.child('Perfiles').child(auth.uid).child('salon').val() && (newData.child('zona').val() == 'Zona 1' || newData.child('zona').val() == 'Zona 2' || newData.child('zona').val() == 'Zona 3' || newData.child('zona').val() == 'Zona 4' || newData.child('zona').val() == 'Zona 5' || newData.child('zona').val() == 'Zona 6')",
        ".validate": "!data.exists() && newData.hasChildren(['uid', 'usuario', 'zona', 'referencia', 'monto', 'fechaAporte', 'semana', 'comentario', 'fechaRegistro', 'rutaComprobante']) && newData.child('uid').val() == auth.uid && newData.child('usuario').isString() && newData.child('usuario').val() == root.child('Perfiles').child(auth.uid).child('usuario').val() && newData.child('zona').val() == root.child('Perfiles').child(auth.uid).child('salon').val() && newData.child('referencia').isString() && newData.child('referencia').val().matches(/^[0-9]{1,40}$/) && newData.child('monto').isNumber() && newData.child('monto').val() > 0 && newData.child('monto').val() <= 1000000000 && newData.child('fechaAporte').isString() && newData.child('fechaAporte').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('semana').isString() && newData.child('semana').val().length == 10 && newData.child('comentario').isString() && newData.child('comentario').val().length <= 500 && newData.child('fechaRegistro').isNumber() && newData.child('rutaComprobante').isString() && (newData.child('rutaComprobante').val() == '' || newData.child('rutaComprobante').val() == 'ComprobantesAportes/' + auth.uid + '/' + $id)",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "usuario": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "zona": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "referencia": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,40}$/)"
        },
        "monto": {
          ".validate": "newData.isNumber()"
        },
        "fechaAporte": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "semana": {
          ".validate": "newData.isString() && newData.val().length == 10"
        },
        "comentario": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "fechaRegistro": {
          ".validate": "newData.isNumber()"
        },
        "rutaComprobante": {
          ".validate": "newData.isString() && newData.val().length <= 220"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ComprobantesAportes": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      "$uid": {
        ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
        "$id": {
          ".write": "auth != null && auth.uid == $uid && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Facilitador' && root.child('Perfiles').child(auth.uid).child('salon').val() != null && ((!data.exists() && !root.child('AportesLimpieza').child($id).exists()) || (data.exists() && !newData.exists() && !root.child('AportesLimpieza').child($id).exists()))",
          ".validate": "newData.isString() && newData.val().length <= 2800000 && newData.val().matches(/^data:image\\/webp;base64,[A-Za-z0-9+/]+=*$/)"
        }
      }
    },
    "BitacoraIglesiaRedencionV1": {
      ".read": "auth != null && (root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador' || root.child('Perfiles').child(auth.uid).child('rol').val() == 'Supervisor')",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).exists()",
      ".indexOn": ["Hoja"]
    },
    "RespaldosIglesiaRedencionV1": {
      ".read": "auth != null && root.child('Perfiles').child(auth.uid).child('rol').val() == 'Administrador'",
      ".write": "auth != null && root.child('Perfiles').child(auth.uid).exists()"
    }
  }
}
